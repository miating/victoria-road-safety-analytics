# Copy this file to .env and fill in your own values.
# .env is ignored by Git - never commit real credentials.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vic_road_safety
DB_USER=postgres
DB_PASSWORD=change_me

# Local PostgreSQL: prefer
# Hosted PostgreSQL (Neon / Supabase): require
DB_SSLMODE=prefer
