/// All report measures. The three fact tables share dimensions (date, location, severity) but
/// are not related to each other, because relating them would create ambiguous filter paths.
/// Where a filter must cross from one fact table to another, the measure copies the set of crash
/// numbers across with TREATAS.
table _Measures
	lineageTag: 4c98bb95-2285-4aaf-b63e-4c3e38582fb3

	/// Number of injury crashes. If a vehicle type is selected, only crashes that involved
	/// a vehicle of that type (the filter reaches fact_crash through fact_vehicle).
	measure 'Total Crashes' =
			IF (
			    ISFILTERED ( dim_vehicle_type ),
			    CALCULATE (
			        COUNTROWS ( fact_crash ),
			        TREATAS ( VALUES ( fact_vehicle[accident_no] ), fact_crash[accident_no] )
			    ),
			    COUNTROWS ( fact_crash )
			)
		formatString: #,0
		displayFolder: Crashes
		lineageTag: a09590ac-af79-488d-83ce-51c5599b5900

	/// Crashes in which at least one person was killed.
	measure 'Fatal Crashes' = CALCULATE ( [Total Crashes], dim_severity[is_fatal] = TRUE () )
		formatString: #,0
		displayFolder: Crashes
		lineageTag: 346ea5dd-2284-4835-aaba-4434de4fe3bd

	/// Crashes whose most severe injury was a serious injury.
	measure 'Serious Injury Crashes' = CALCULATE ( [Total Crashes], dim_severity[severity_code] = 2 )
		formatString: #,0
		displayFolder: Crashes
		lineageTag: c73e1a01-b495-4b1d-b2ee-eaa287b51745

	/// KSI: crashes in which someone was killed or seriously injured.
	measure 'KSI Crashes' = CALCULATE ( [Total Crashes], dim_severity[is_fatal_or_serious] = TRUE () )
		formatString: #,0
		displayFolder: Crashes
		lineageTag: 1a5010a3-552d-48fa-9e6e-40a8e856e671

	/// Share of crashes that were fatal or serious - how severe crashes are when they happen.
	measure 'KSI Share' = DIVIDE ( [KSI Crashes], [Total Crashes] )
		formatString: 0.0%
		displayFolder: Crashes
		lineageTag: cea31953-b7bb-47b9-a901-a6394f1ef8a7

	/// Share of crashes that were fatal.
	measure 'Fatal Share' = DIVIDE ( [Fatal Crashes], [Total Crashes] )
		formatString: 0.00%
		displayFolder: Crashes
		lineageTag: 506796aa-09b8-4693-9491-cffa93834c90

	/// People killed, from the crash-level count.
	measure 'Persons Killed' =
			IF (
			    ISFILTERED ( dim_vehicle_type ),
			    CALCULATE (
			        SUM ( fact_crash[persons_killed] ),
			        TREATAS ( VALUES ( fact_vehicle[accident_no] ), fact_crash[accident_no] )
			    ),
			    SUM ( fact_crash[persons_killed] )
			)
		formatString: #,0
		displayFolder: Crashes
		lineageTag: 6c49dcdc-9996-4a56-843f-2ee341434926

	/// Crashes per calendar day in the selection. Use instead of Total Crashes when comparing
	/// weekdays or months, which contain different numbers of days.
	measure 'Crashes per Day' = DIVIDE ( [Total Crashes], COUNTROWS ( dim_date ) )
		formatString: #,0.0
		displayFolder: Crashes
		lineageTag: 75713f71-2c79-4003-8537-429142b43a7f

	/// Change for the latest selected year against the year before. Blank unless both years are
	/// complete, because months from 2025 onwards are only partly reported (DQ24).
	measure 'Crashes YoY %' =
			VAR LatestYear = MAX ( dim_date[year] )
			VAR CurrentCrashes = CALCULATE ( [Total Crashes], dim_date[year] = LatestYear )
			VAR PreviousCrashes = CALCULATE ( [Total Crashes], dim_date[year] = LatestYear - 1 )
			VAR IncompleteDays =
			    CALCULATE (
			        COUNTROWS ( dim_date ),
			        REMOVEFILTERS ( dim_date ),
			        dim_date[year] IN { LatestYear, LatestYear - 1 },
			        dim_date[is_analysis_period] = FALSE ()
			    )
			RETURN
			    IF (
			        IncompleteDays = 0 && PreviousCrashes > 0,
			        DIVIDE ( CurrentCrashes - PreviousCrashes, PreviousCrashes )
			    )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Year over year
		lineageTag: f67a779f-55fb-4eb3-a925-b13c0ccbdaf9

	/// Card subtitle for the YoY measure, e.g. "2024 vs 2023".
	measure 'YoY Label' =
			VAR LatestYear = MAX ( dim_date[year] )
			RETURN LatestYear & " vs " & ( LatestYear - 1 )
		displayFolder: Year over year
		lineageTag: 29e505fb-92eb-435b-b5de-77aead90ccdc

	/// LGA with the most KSI crashes in the selection ("most affected"). Unknown location is
	/// excluded; ties return both names.
	measure 'Most Affected LGA' =
			VAR TopLga =
			    TOPN (
			        1,
			        FILTER ( VALUES ( dim_location[lga_name] ), dim_location[lga_name] <> "Unknown" ),
			        [KSI Crashes], DESC
			    )
			RETURN
			    CONCATENATEX ( TopLga, dim_location[lga_name], ", " )
		displayFolder: Location
		lineageTag: de125245-98cd-45c9-ac69-2f7d9a801a4b

	/// KSI crashes in the most affected LGA.
	measure 'Most Affected LGA KSI Crashes' =
			MAXX (
			    FILTER ( VALUES ( dim_location[lga_name] ), dim_location[lga_name] <> "Unknown" ),
			    [KSI Crashes]
			)
		formatString: #,0
		displayFolder: Location
		lineageTag: 59982d4e-6150-4520-8995-2cc9460cd2a7

	/// People involved in crashes. Follows crash-level filters (weather, light, ...) through
	/// fact_crash with TREATAS.
	measure 'People Involved' =
			CALCULATE (
			    COUNTROWS ( fact_person ),
			    TREATAS ( VALUES ( fact_crash[accident_no] ), fact_person[accident_no] )
			)
		formatString: #,0
		displayFolder: People
		lineageTag: ce18a0e4-67e8-469f-8b03-f6165b6e1c40

	measure 'People Killed' = CALCULATE ( [People Involved], dim_injury_level[injury_level_code] = 1 )
		formatString: #,0
		displayFolder: People
		lineageTag: ee5e75a9-21e2-4088-85cc-81a4278477eb

	measure 'People Killed or Seriously Injured' = CALCULATE ( [People Involved], dim_injury_level[injury_level_code] IN { 1, 2 } )
		formatString: #,0
		displayFolder: People
		lineageTag: fc74937e-a086-4da5-a778-3a6ce1555eff

	/// Share of people involved who were killed or seriously injured.
	measure 'People KSI %' = DIVIDE ( [People Killed or Seriously Injured], [People Involved] )
		formatString: 0.0%
		displayFolder: People
		lineageTag: aa91e4c1-a1e3-45a3-8f91-29a54f2d29fc

	measure 'Killed per 1,000 People Involved' = DIVIDE ( [People Killed], [People Involved] ) * 1000
		formatString: 0.0
		displayFolder: People
		lineageTag: 3245e08d-c767-44aa-8e78-a67407268d85

	/// Vehicles involved in crashes. Follows crash-level filters through fact_crash.
	measure 'Vehicles Involved' =
			CALCULATE (
			    COUNTROWS ( fact_vehicle ),
			    TREATAS ( VALUES ( fact_crash[accident_no] ), fact_vehicle[accident_no] )
			)
		formatString: #,0
		displayFolder: Vehicles
		lineageTag: 92160208-cec0-4235-bbe6-3c4b6a3c0c17

	/// Share of vehicles whose crash was fatal or serious. Severity belongs to the crash: a car
	/// that hits a pedestrian counts even if nobody in the car was hurt.
	measure 'Vehicles in KSI Crash %' =
			DIVIDE (
			    CALCULATE ( [Vehicles Involved], dim_severity[is_fatal_or_serious] = TRUE () ),
			    [Vehicles Involved]
			)
		formatString: 0.0%
		displayFolder: Vehicles
		lineageTag: 117ff5a4-bf07-4917-b303-d2248bcbd54a

	/// Residents (ABS estimated resident population) summed over the selected years and LGAs,
	/// so a rate over several years is per person-year. LGAs that ABS does not list (alpine
	/// resorts, Unknown) have no population and are left out.
	measure 'Resident Population' =
			CALCULATE (
			    SUM ( lga_population[population] ),
			    TREATAS ( VALUES ( dim_date[year] ), lga_population[year] ),
			    TREATAS ( VALUES ( dim_location[lga_name_current] ), lga_population[lga_name] )
			)
		formatString: #,0
		displayFolder: Rates
		lineageTag: cc298135-62ea-4190-8509-047cac321f66

	/// KSI crashes in LGAs that have a population figure, so numerator and denominator match.
	/// KEEPFILTERS: intersect with the current LGA instead of replacing it.
	measure 'KSI Crashes in Populated LGAs' =
			CALCULATE (
			    [KSI Crashes],
			    KEEPFILTERS ( TREATAS ( VALUES ( lga_population[lga_name] ), dim_location[lga_name_current] ) )
			)
		formatString: #,0
		displayFolder: Rates
		lineageTag: f62d8e6e-0c2e-4ad4-9c84-ff6e5fbc0c33

	/// KSI crashes per 100,000 residents per year. Crashes are counted where they happen and
	/// residents where they live, so LGAs with through traffic or visitors (the CBD, tourist
	/// routes) score high. A per-resident rate, not a measure of traffic exposure.
	measure 'KSI Crashes per 100k Residents' = DIVIDE ( [KSI Crashes in Populated LGAs], [Resident Population] ) * 100000
		formatString: 0.0
		displayFolder: Rates
		lineageTag: e4c526bc-bb94-47d2-9fc9-12431aefa80f

	/// Rate for the whole state in the selected years, ignoring the LGA, for comparison.
	measure 'Victoria KSI per 100k Residents' = CALCULATE ( [KSI Crashes per 100k Residents], REMOVEFILTERS ( dim_location ) )
		formatString: 0.0
		displayFolder: Rates
		lineageTag: 04050d38-9b1a-44ba-9265-ce7fcd72f667

	/// Difference from the state rate: positive means above the Victorian average. Blank where
	/// the LGA has no population figure.
	measure 'KSI Rate vs Victoria %' =
			VAR Rate = [KSI Crashes per 100k Residents]
			VAR StateRate = [Victoria KSI per 100k Residents]
			RETURN IF ( NOT ISBLANK ( Rate ), DIVIDE ( Rate - StateRate, StateRate ) )
		formatString: +0%;-0%;0%
		displayFolder: Rates
		lineageTag: abc5cfd5-7f88-4b47-afee-e469d785a378

	/// People killed in each year of the target axis. Years outside the complete-years filter
	/// (2025 onwards) are blank because the report filter on dim_date still applies.
	measure 'Deaths (Actual)' = CALCULATE ( [Persons Killed], TREATAS ( VALUES ( road_safety_target[year] ), dim_date[year] ) )
		formatString: #,0
		displayFolder: Strategy target
		lineageTag: 78521156-be52-401c-8e36-1cb1c2f72640

	/// Deaths in 2019, the latest year the Road Safety Strategy cites (266). The strategy does not
	/// name a formal baseline year; 2019 is the assumption used here.
	measure 'Baseline Deaths 2019' = CALCULATE ( [Persons Killed], REMOVEFILTERS ( dim_date ), dim_date[year] = 2019 )
		formatString: #,0
		displayFolder: Strategy target
		lineageTag: 5c8c0cfd-1680-4782-8b81-be3d5cda02ab

	/// Straight-line path from the 2019 baseline to half of it in 2030. Blank before 2019.
	measure 'Target Deaths' =
			VAR TargetYear = SELECTEDVALUE ( road_safety_target[year] )
			RETURN
			    IF (
			        TargetYear >= 2019,
			        [Baseline Deaths 2019] * ( 1 - 0.5 * ( TargetYear - 2019 ) / 11 )
			    )
		formatString: #,0
		displayFolder: Strategy target
		lineageTag: 334132e9-c5db-496d-920f-c483fdc3d2a9

	/// Latest year whose twelve months are all reported (DQ24).
	measure 'Latest Complete Year' = CALCULATE ( MAX ( dim_date[year] ), REMOVEFILTERS ( dim_date ), dim_date[is_analysis_period] = TRUE () )
		formatString: 0
		displayFolder: Strategy target
		lineageTag: c1e5c6f3-725b-4e0c-9f56-95a2c607d743

	/// Deaths in the latest complete year.
	measure 'Deaths Latest Year' =
			VAR LatestYear = [Latest Complete Year]
			RETURN CALCULATE ( [Persons Killed], REMOVEFILTERS ( dim_date ), dim_date[year] = LatestYear )
		formatString: #,0
		displayFolder: Strategy target
		lineageTag: 1fe50aa0-9304-4e1b-be90-553499e7264e

	/// Where the straight-line path says deaths should be in the latest complete year.
	measure 'Target Deaths Latest Year' =
			VAR LatestYear = [Latest Complete Year]
			RETURN [Baseline Deaths 2019] * ( 1 - 0.5 * ( LatestYear - 2019 ) / 11 )
		formatString: #,0
		displayFolder: Strategy target
		lineageTag: fd986ba7-7656-4671-a2a9-db2a99590dbc

	/// How far the latest year is above (+) or below (-) the target path.
	measure 'Deaths vs Target %' = DIVIDE ( [Deaths Latest Year] - [Target Deaths Latest Year], [Target Deaths Latest Year] )
		formatString: +0%;-0%;0%
		displayFolder: Strategy target
		lineageTag: d6387e40-f72f-4379-9bea-5fd911d5734a

	/// Constant yearly fall needed from the latest complete year to reach half the baseline in 2030.
	measure 'Required Annual Reduction to 2030' =
			VAR YearsLeft = 2030 - [Latest Complete Year]
			VAR Target2030 = [Baseline Deaths 2019] / 2
			RETURN
			    IF ( YearsLeft > 0 && [Deaths Latest Year] > 0, 1 - ( Target2030 / [Deaths Latest Year] ) ^ ( 1 / YearsLeft ) )
		formatString: 0.0%
		displayFolder: Strategy target
		lineageTag: 843b9eb6-8137-45c6-99fa-c716b6bbdbbb

	/// Placeholder so the table can exist; hidden from report view.
	column Placeholder
		dataType: string
		isHidden
		lineageTag: 942be3d0-852e-4d77-9586-a0330273627e
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = text], {})
				in
				    Source

