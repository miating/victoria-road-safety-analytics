// DAX measures for the Victoria Road Safety dashboard.
// Create a blank table named _Measures (Home > Enter data > OK) and add each measure to it.
// Table names assume the "analytics " prefix was removed in Power Query (see powerbi/README.md).
//
// Why TREATAS: the three fact tables share dimensions (date, location, severity) but are not
// related to each other. Relating them directly would create ambiguous filter paths. Instead,
// a measure copies the set of crash numbers from one fact table onto another only when needed:
//   - crash measures follow a vehicle-type filter through fact_vehicle
//   - person and vehicle measures follow crash-level filters (weather, light, ...) through fact_crash


// ---------------------------------------------------------------- Crash measures

Total Crashes =
IF (
    ISFILTERED ( dim_vehicle_type ),
    // Keep only crashes that involved a vehicle of the selected type(s).
    CALCULATE (
        COUNTROWS ( fact_crash ),
        TREATAS ( VALUES ( fact_vehicle[accident_no] ), fact_crash[accident_no] )
    ),
    COUNTROWS ( fact_crash )
)

Fatal Crashes =
CALCULATE ( [Total Crashes], dim_severity[is_fatal] = TRUE () )

Serious Injury Crashes =
CALCULATE ( [Total Crashes], dim_severity[severity_code] = 2 )

KSI Crashes =
CALCULATE ( [Total Crashes], dim_severity[is_fatal_or_serious] = TRUE () )

// Format: Percentage, 1 decimal place
KSI Share =
DIVIDE ( [KSI Crashes], [Total Crashes] )

// Format: Percentage, 2 decimal places
Fatal Share =
DIVIDE ( [Fatal Crashes], [Total Crashes] )

Persons Killed =
IF (
    ISFILTERED ( dim_vehicle_type ),
    CALCULATE (
        SUM ( fact_crash[persons_killed] ),
        TREATAS ( VALUES ( fact_vehicle[accident_no] ), fact_crash[accident_no] )
    ),
    SUM ( fact_crash[persons_killed] )
)

// Crashes per calendar day in the current selection. Use this, not Total Crashes, when
// comparing weekdays or months, which have different numbers of days.
// Format: Decimal number, 1 decimal place
Crashes per Day =
DIVIDE ( [Total Crashes], COUNTROWS ( dim_date ) )


// ---------------------------------------------------------------- Year-over-year

// Change for the latest year in the current selection against the year before.
// Blank unless both years are complete (2025 onwards is only partly reported - DQ24).
// Format: Percentage, 1 decimal place
Crashes YoY % =
VAR LatestYear = MAX ( dim_date[year] )
VAR CurrentCrashes = CALCULATE ( [Total Crashes], dim_date[year] = LatestYear )
VAR PreviousCrashes = CALCULATE ( [Total Crashes], dim_date[year] = LatestYear - 1 )
VAR IncompleteDays =
    CALCULATE (
        COUNTROWS ( dim_date ),
        REMOVEFILTERS ( dim_date ),
        dim_date[year] IN { LatestYear, LatestYear - 1 },
        dim_date[is_analysis_period] = FALSE ()
    )
RETURN
    IF (
        IncompleteDays = 0 && PreviousCrashes > 0,
        DIVIDE ( CurrentCrashes - PreviousCrashes, PreviousCrashes )
    )

// Card subtitle, e.g. "2024 vs 2023"
YoY Label =
VAR LatestYear = MAX ( dim_date[year] )
RETURN LatestYear & " vs " & ( LatestYear - 1 )


// ---------------------------------------------------------------- Location

// "Most affected" is defined as the LGA with the most KSI crashes in the current selection.
// Crashes with unknown location are excluded. Ties return both names.
Most Affected LGA =
VAR TopLga =
    TOPN (
        1,
        FILTER ( VALUES ( dim_location[lga_name] ), dim_location[lga_name] <> "Unknown" ),
        [KSI Crashes], DESC
    )
RETURN
    CONCATENATEX ( TopLga, dim_location[lga_name], ", " )

Most Affected LGA KSI Crashes =
MAXX (
    FILTER ( VALUES ( dim_location[lga_name] ), dim_location[lga_name] <> "Unknown" ),
    [KSI Crashes]
)


// ---------------------------------------------------------------- People (fact_person)

People Involved =
CALCULATE (
    COUNTROWS ( fact_person ),
    TREATAS ( VALUES ( fact_crash[accident_no] ), fact_person[accident_no] )
)

People Killed =
CALCULATE ( [People Involved], dim_injury_level[injury_level_code] = 1 )

People Killed or Seriously Injured =
CALCULATE ( [People Involved], dim_injury_level[injury_level_code] IN { 1, 2 } )

// Format: Percentage, 1 decimal place
People KSI % =
DIVIDE ( [People Killed or Seriously Injured], [People Involved] )

// Format: Decimal number, 1 decimal place
Killed per 1,000 People Involved =
DIVIDE ( [People Killed], [People Involved] ) * 1000


// ---------------------------------------------------------------- Vehicles (fact_vehicle)

Vehicles Involved =
CALCULATE (
    COUNTROWS ( fact_vehicle ),
    TREATAS ( VALUES ( fact_crash[accident_no] ), fact_vehicle[accident_no] )
)

// Share of vehicles whose crash was fatal or serious. Severity belongs to the crash, not the
// vehicle: a car that hits a pedestrian counts even if nobody in the car was hurt.
// Format: Percentage, 1 decimal place
Vehicles in KSI Crash % =
DIVIDE (
    CALCULATE ( [Vehicles Involved], dim_severity[is_fatal_or_serious] = TRUE () ),
    [Vehicles Involved]
)
