# Secrets
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# Data - raw and processed files are downloaded/generated, not versioned
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/raw/manifest.json
!data/processed/.gitkeep

# Logs
*.log

# Power BI: the report is stored as a Power BI Project (.pbip, text files).
# The binary .pbix, the local data cache and per-user settings are not versioned.
*.pbix
*.pbix.bak
~$*.pbix
**/.pbi/cache.abf
**/.pbi/localSettings.json

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
