                    <TablixCell>
                      <CellContents>
                        <Textbox Name="sum_crashes_change">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(Sum(Fields!prev_crashes.Value) = 0, Nothing, (Sum(Fields!crashes.Value) - Sum(Fields!prev_crashes.Value)) / Sum(Fields!prev_crashes.Value))</Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <Color>=IIf(Me.Value &gt; 0, "#B42318", IIf(Me.Value &lt; 0, "#1A7F37", "#1F2328"))</Color>
                                    <Format>+0.0%;-0.0%;0.0%</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
